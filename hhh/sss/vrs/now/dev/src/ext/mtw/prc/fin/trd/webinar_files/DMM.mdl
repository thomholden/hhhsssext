  state {
    id			    4
    labelString		    "BidAsk"
    position		    [521.192 5.475 169.25 48]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 6]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    8
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function BidAsk()\n\nN=111; \n% calculate expected value\nEorig = sum(V.*P);\n% round to nearest "
      "cent\nE = round(Eorig*100)/100;\nt=0.5+0.5*alpha;\n% find where E occurs in V\n%[m,EN]=min(abs(V-E));\nbiderror="
      "zeros(N,1);\nPB=zeros(N,1);\n% loop over all values of V from Vmin to E\nfor i=1:N\n    [PB(i), biderror(i)]=bid"
      "Calc(i,V,P,t);\nend\n\n[minerr,ind]=min(biderror);\nPb=min(V(ind),E);\n\naskerror=zeros(N,1);\nPA=zeros(N,1);\n%"
      " loop over all values of V from E to Vmax\nfor i=1:N\n    [PA(i), askerror(i)]=askCalc(i,V,P,t);\nend\n[minerr,i"
      "nd]=min(askerror);\nPa=max(V(ind), E);\n\n%%% ============================== %%%%\nfunction [PB,BidErr]=bidCalc("
      "count,V,P,t)\nN=length(V);\na=0;b=0;\nfor i=1:count\n    a = a+V(i)*P(i);\nend\n\nfor i=count+1:N\n    b = b+V(i"
      ")*P(i);\nend\nPB=2*(t*a + (1-t)*b);\nBidErr = abs(V(count) - PB);\n\n%%%% ============================ %%%%\nfun"
      "ction [PB,BidErr]=askCalc(count,V,P,t)\nN=length(V);\na=0;b=0;\nfor i=1:count-1\n    a = a+V(i)*P(i);\nend\n\nfo"
      "r i=count:N\n    b = b+V(i)*P(i);\nend\nPB=2*((1-t)*a + t*b);\nBidErr = abs(V(count) - PB);"
      editorLayout	      "100 M4x1[258 14 732 780]"
      fimathForFiConstructors FimathMatlabFactoryDefault
    }
  }
  state {
    id			    5
    labelString		    "Prob(Price,trade)"
    position		    [8.536 336.171 168.625 46.125]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 3 7]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    9
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    firstData		    15
    eml {
      isEML		      1
      script		      "function Prob(Price,trade)\n% calculate the probability vector\n% trade is in [-1 0 1] representi"
      "ng sell, flat, buy orders\nPold=P;\np=(0.5+0.5*alpha);\nif trade < 0\n    % sell order received\n    for i=1:siz"
      "e(V,1)\n        if V(i,1) < Price\n            P(i,1)=Pold(i,1)*p;\n        else\n            P(i,1)=Pold(i,1)*("
      "1-p);\n        end\n    end\nelse %trade > 0\n    % buy order received\n    for i=1:size(V,1)\n        if V(i) >"
      " Price\n            P(i,1)=Pold(i,1)*p;\n        else\n            P(i,1)=Pold(i,1)*(1-p);\n        end\n    end"
      "\nend\n\n% normalise\nP=P/sum(P);"
      editorLayout	      "100 M4x1[142 26 905 780]"
      fimathForFiConstructors FimathMatlabFactoryDefault
    }
  }
  state {
    id			    6
    labelString		    "icontrol"
    position		    [17.049 10.788 167.875 46.125]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 4 3]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    40
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function icontrol()\n\n% sigmoidal function\nsig = (10*(1+tanh(-3:0.5:3)));\nxc= 0:length(sig)-1;"
      "\n\n% calculate offset\noffset = round(sign(pos)*interp1(xc,sig,abs(pos),'linear',max(sig)))/100;\n%offset=0;\ni"
      "f pos>0\n    Pa=Pa-offset;\n    Pb=Pb-offset;\nend\n\n\n\n"
      editorLayout	      "100 M4x1[9 25 1032 746]"
      fimathForFiConstructors FimathMatlabFactoryDefault
    }
  }
  state {
    id			    7
    labelString		    "initProb"
    position		    [9.3365 391.0755 168.625 46.125]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 5 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    53
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function initProb()\n% initial grid of prices\n\nx0=28.5850;\n%x0=27.97;\nV=(27.9:0.01:29)';\n% n"
      "ormal distn centered around an initial point\ndistn= (1/(sigma*sqrt(2*pi)))*exp(-(V-x0).^2/(2*sigma^2));\ndistn="
      "distn/sum(distn);\nP=distn;"
      editorLayout	      "100 M4x1[258 14 732 780]"
      fimathForFiConstructors FimathMatlabFactoryDefault
    }
  }
