    Annotation {
      SID		      "312"
      Name		      "INSTRUCTIONS\n1. With the included sl_customization on your MATLAB path, at the\n    MATLAB command"
      " prompt run sl_refresh_customizations\n2. Move the mux block with 2 inputs to the right of the inport blocks\n3."
      " Select all of the inport blocks\n4. With all the inport blocks selected, right click on one of the inport \n   "
      " blocks and select AutoSizeOnConnect\n5. Click on the Mux block\n\n6. Move the demux block with 2 outputs to the"
      " right of the outport blocks\n7. Select all of the outport blocks\n8. With all the outport blocks selected, righ"
      "t click on one of the outport\n    blocks and select AutoSizeOnConnect\n9. Click on the Demux block\n\n10. Selec"
      "t the subsystem Multiple_Outs.\n11. Right-click on the subsystem Multple_Outs and select AutoSizeOnConnect\n12. "
      "Click on the Bus Creator block\n\n13. Select the subsystem Multiple_Outs1 and the inport blocks In5 and In6.\n14"
      ". Right-click and select AutoSizeOnConnect.\n15. Click the Scope Block.\n\nNOTE: This is also using the AutoSize"
      " capability. Without AutoSize, this \nfunction will still automatically create the right number of ports for the"
      " \nmux/demux, but will not resize the block to make the lines straight."
      Position		      [249, 410]
      HorizontalAlignment     "left"
      DropShadow	      on
      FontName		      "Arial Narrow"
      FontSize		      14
    }
