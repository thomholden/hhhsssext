<deployment-project plugin="plugin.apptool" plugin-version="1.0">
  <configuration build-checksum="2139670937" file="/mathworks/UK/devel/sandbox/btordoff/Bgpu/matlab/toolbox/distcomp/internal/fileexchange/gpubench/package/gpuBench.prj" location="/mathworks/UK/devel/sandbox/btordoff/Bgpu/matlab/toolbox/distcomp/internal/fileexchange/gpubench/package" name="gpuBench" target="target.mlapps" target-name="Package App">
